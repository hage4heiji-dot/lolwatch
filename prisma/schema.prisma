generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Riotの PUUID は改名しても変わらない不変IDなので、これを同定の軸にする。
model Player {
  id        String   @id @default(uuid())
  puuid     String   @unique
  platform  String
  createdAt DateTime @default(now())

  nameHistory      PlayerNameHistory[]
  reports          Report[]
  rankActivity     RankActivityCheck[]

  @@index([platform])
}

// 表示名(Riot ID)の変遷履歴。改名を追従するための記録。
model PlayerNameHistory {
  id            String   @id @default(uuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  riotIdName    String
  riotIdTagLine String
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  isCurrent     Boolean  @default(true)

  @@unique([playerId, riotIdName, riotIdTagLine])
  @@index([riotIdName, riotIdTagLine])
}

enum ReportCategory {
  VERBAL_ABUSE
  HATE_SPEECH
  INTENTIONAL_FEEDING
  AFK_LEAVING
  CHEATING
  SMURFING
  ACCOUNT_TRADING
}

// 一般ユーザーからの通報。固定カテゴリ+任意の目安時間+任意の短いコメント。
// 即時公開だが、投稿元IP/deviceIdは表示せず内部保持のみ(発信者情報開示請求への備え)。
model Report {
  id         String          @id @default(uuid())
  playerId   String
  player     Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category   ReportCategory
  // 対象の試合。通報者がLoLクライアント上で特定したmatchIdを入力し、
  // その試合の参加者一覧(Riot APIで1回取得)から対象アカウントを選ぶ形で必ず紐付く。
  matchId       String
  championName  String
  queueId       Int
  // 通報された時点でのソロ/デュオランク(ソロ/デュオ未参加なら"UNRANKED")。
  // Riot API問い合わせに失敗した場合はnull(取得できなかったという意味で、
  // "UNRANKED"とは区別する)。統計の「通報されたユーザーのランク」集計に使う。
  reportedTier String?
  // 問題のシーンの試合内経過時間(秒)。通報者が試合タイムラインを見て任意入力する目安。
  incidentTimestampSeconds Int?
  // 何を主張したいかの補足。即時・無検証で公開されるため短文(300字)に制限する。
  comment    String?
  // リプレイにはチャットログ等が残らないため、通報者が任意で添付する参考URL
  // (X投稿・YouTube動画・imgur画像等)。自前ではファイルを保持せず、
  // モデレーターがリプレイと合わせて確認する参考証跡としてリンクを貼るのみ。
  // http/httpsのみ許可。
  referenceUrl String?
  deviceId   String
  posterIp   String
  createdAt  DateTime        @default(now())
  hiddenAt   DateTime?
  hiddenReason String?

  moderatorReviews ModeratorReview[]
  votes            ReportVote[]
  deletionRequests ReportDeletionRequest[]

  @@index([playerId, createdAt])
  @@index([deviceId, createdAt])
  @@index([posterIp, createdAt])
}

// 通報自体への「削除してほしい」という一般ユーザーからの申請。異議申立(ReviewObjection)
// と同様、申請=即削除ではなくモデレーターへの再確認シグナルとして扱う。
// 承認された場合はReportの非表示(hiddenAt/hiddenReason)機能を使う想定で、
// この申請自体がReportを削除・非表示にする効力を持つわけではない。
model ReportDeletionRequest {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  deviceId  String
  posterIp  String
  reason    String
  createdAt DateTime @default(now())

  @@unique([reportId, deviceId])
  @@index([reportId])
}

enum VoteType {
  LIKE
  DISLIKE
}

// 通報に対する一般ユーザーの「いいね/悪いね」。モデレーターの検証結果とは違い、
// あくまで参考シグナル。device単位で1票のみ(同じボタンを再度押すと取り消し)。
model ReportVote {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  voteType  VoteType
  deviceId  String
  posterIp  String
  createdAt DateTime @default(now())

  @@unique([reportId, deviceId])
  @@index([reportId, voteType])
}

model Moderator {
  id                  String    @id @default(uuid())
  username            String    @unique
  passwordHash        String
  displayName         String
  // 管理者権限(通報の非表示化など)を持つかどうか。付与はCLIスクリプト経由のみ。
  isAdmin             Boolean   @default(false)
  createdAt           DateTime  @default(now())
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  reviews  ModeratorReview[]
  sessions ModeratorSession[]
}

// ログイントークンはハッシュ化して保存する(Cookieには生トークンのみ)。
model ModeratorSession {
  id          String    @id @default(uuid())
  moderatorId String
  moderator   Moderator @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([moderatorId])
}

enum ModeratorVerdict {
  VIOLATION_CONFIRMED
  NO_VIOLATION
  INSUFFICIENT_EVIDENCE
}

// モデレーターが判断指針に沿って実際にリプレイを確認した上での評価。
// 特定の通報(=特定の試合)に対する評価として紐付ける。一般ユーザーの通報(Report)
// とはUI上明確に区別して表示する。
model ModeratorReview {
  id                String           @id @default(uuid())
  reportId          String
  report            Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moderatorId       String
  moderator         Moderator        @relation(fields: [moderatorId], references: [id])
  verdict           ModeratorVerdict
  rationale         String
  createdAt         DateTime         @default(now())

  objections ReviewObjection[]

  @@index([reportId, createdAt])
}

// モデレーター評価に対する一般ユーザーからの「異議あり」。投票の集計ではなく
// 再審査を促すシグナルとして扱う(投票による多数決で判定を覆す仕組みではない)。
model ReviewObjection {
  id                String          @id @default(uuid())
  moderatorReviewId String
  moderatorReview   ModeratorReview @relation(fields: [moderatorReviewId], references: [id], onDelete: Cascade)
  deviceId          String
  posterIp          String
  createdAt         DateTime        @default(now())

  @@unique([moderatorReviewId, deviceId])
  @@index([moderatorReviewId])
}

// scripts/post-daily-violations.tsの実行記録。dateKeyで一意にし、コンテナ再起動
// (デプロイ・クラッシュ復帰等)で同じ日に二重実行されても再投稿しないようにする
// (workerはwhile true; sleep 86400のループで、起動直後に必ず1回実行されるため)。
model DailyXPost {
  id        String   @id @default(uuid())
  dateKey   String   @unique
  postedAt  DateTime @default(now())
}

// 「通報がちゃんと機能してランク参加できなくなっているか」の監視。
// 直近のランク参加有無をバッチで定期確認して記録する。
model RankActivityCheck {
  id                 String   @id @default(uuid())
  playerId           String
  player             Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  checkedAt          DateTime @default(now())
  isActiveInRanked   Boolean
  lastRankedMatchAt  DateTime?

  @@index([playerId, checkedAt])
}

// 一般ユーザー向け「判定基準診断」の1回分の受験。シナリオ本体は
// src/lib/calibrationScenarios.ts にハードコードしており、DBでは持たない
// (ガイドライン文言と同じ方針。運用しながらコードで調整する前提のデータのため)。
model CalibrationAttempt {
  id        String   @id @default(uuid())
  deviceId  String
  posterIp  String
  createdAt DateTime @default(now())

  answers CalibrationAnswer[]

  @@index([deviceId, createdAt])
}

// 各シナリオへの回答。scoreは1(違反)〜5(問題なし)の5段階。
// scenarioKeyはcalibrationScenarios.tsのSCENARIOSのkeyと対応させる(DB外部キーではない)。
model CalibrationAnswer {
  id          String             @id @default(uuid())
  attemptId   String
  attempt     CalibrationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  scenarioKey String
  score       Int
  createdAt   DateTime           @default(now())

  @@unique([attemptId, scenarioKey])
  @@index([scenarioKey])
}
