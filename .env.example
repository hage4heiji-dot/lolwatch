DATABASE_URL=postgresql://lolwatch:CHANGE_ME@postgres:5432/lolwatch?schema=public
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_PLATFORM=jp1
RIOT_REGION=asia
# scripts/check-rank-activity.ts の設定(任意、未指定時は既定値を使用)
RANK_CHECK_WINDOW_DAYS=3
RIOT_API_MIN_INTERVAL_MS=1300

# X(Twitter)自動投稿(すべて任意。1つでも未設定の場合は投稿機能が自動的にオフになる)。
# scripts/post-daily-violations.tsが、前日に「違反確認」となったユーザーの日次まとめを投稿する
# (課金対策のため投稿本文にURLは含めない。サイトへの導線はXプロフィール欄のリンクに任せる)。
# X Developer Portalでアプリを作成し、User authentication settingsを
# 「Read and Write」にした上でAPI Key/Secret、Access Token/Secretを発行する。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
